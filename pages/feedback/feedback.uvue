  min-height: 100vh;
  padding: 24px 16px;
}

.intro {
  margin: 4px 4px 20px;
}

.title {
  color: $uni-color-title;
  font-size: 24px;
  font-weight: 600;
}

.subtitle {
  margin-top: 8px;
  color: $uni-text-color-grey;
  font-size: 13px;
}

.form-card {
  padding: 20px 16px;
  border-radius: 16px;
  background-color: $uni-bg-color;
}

.section-title {
  color: $uni-text-color;
  font-size: 15px;
  font-weight: 600;
}

.type-list {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 14px;
  margin-bottom: 24px;
}

.type-chip {
  margin-right: 10px;
  margin-bottom: 8px;
  padding: 8px 14px;
  border-width: 1px;
  border-style: solid;
  border-color: $uni-border-color;
  border-radius: 18px;
  background-color: $uni-bg-color;
}

.type-chip-active {
  border-color: $uni-color-primary;
  background-color: $uni-color-primary-light;
}

.type-text {
  color: $uni-text-color-grey;
  font-size: 13px;
}

.type-text-active {
  color: $uni-color-primary;
}

.field-heading {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.counter {
  color: $uni-text-color-placeholder;
  font-size: 12px;
}

.content-input {
  width: 100%;
  height: 150px;
  padding: 12px;
  border-radius: 10px;
  background-color: $uni-bg-color-grey;
  color: $uni-text-color;
  font-size: 14px;
}

.image-heading {
  margin-top: 24px;
}

.image-list {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}

.image-item,
.add-image {
  position: relative;
  width: 88px;
  height: 88px;
  margin-right: 10px;
  margin-bottom: 10px;
  border-radius: 10px;
}

.feedback-image {
  width: 88px;
  height: 88px;
  border-radius: 10px;
}

.remove-image {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 20px;
  height: 20px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background-color: $uni-bg-color-mask-strong;
}

.remove-image-text {
  color: $uni-text-color-inverse;
  font-size: 14px;
}

.add-image {
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-style: dashed;
  border-color: $uni-border-color;
  background-color: $uni-bg-color-grey;
}

.add-image-icon {
  color: $uni-text-color-placeholder;
  font-size: 28px;
}

.add-image-label {
  margin-top: 2px;
  color: $uni-text-color-grey;
  font-size: 11px;
}

.input-placeholder {
  color: $uni-text-color-placeholder;
  font-size: 13px;
}

.contact-heading {
  margin-top: 24px;
  margin-bottom: 12px;
}

.contact-input {
  height: 46px;
  padding: 0 12px;
  border-radius: 10px;
  background-color: $uni-bg-color-grey;
  color: $uni-text-color;
  font-size: 14px;
}

.notice {
  margin: 14px 4px 18px;
}

.notice-text {
  color: $uni-text-color-grey;
  font-size: 12px;
}

.submit-button {
  height: 48px;
  line-height: 48px;
  border-radius: 12px;
  background-color: $uni-color-primary;
  color: $uni-text-color-inverse;
  font-size: 16px;
}

.submit-button-disabled {
  opacity: 0.6;
}
</style>
