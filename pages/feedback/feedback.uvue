<template>
  <view class="page">
    <view class="intro">
      <text class="title">意见反馈</text>
      <text class="subtitle">期待听到你的想法，帮助我们做得更好</text>
    </view>

    <view class="form-card">
      <text class="section-title">反馈类型</text>
      <view class="type-list">
        <view v-for="type in feedbackTypes" :key="type"
          :class="selectedType === type ? 'type-chip type-chip-active' : 'type-chip'" @click="selectType(type)">
          <text :class="selectedType === type ? 'type-text type-text-active' : 'type-text'">{{ type }}</text>
        </view>
      </view>

      <view class="field-heading">
        <text class="section-title">反馈内容</text>
        <text class="counter">{{ content.length }}/500</text>
      </view>
      <textarea class="content-input" v-model="content" maxlength="500" placeholder="请描述你遇到的问题或想提出的建议..."
        placeholder-class="input-placeholder" />

      <view class="field-heading image-heading">
        <text class="section-title">上传图片（选填）</text>
        <text class="counter">{{ imagePaths.length }}/3</text>
      </view>
      <view class="image-list">
        <view v-for="(imagePath, index) in imagePaths" :key="imagePath" class="image-item">
          <image class="feedback-image" :src="imagePath" mode="aspectFill" @click="previewImage(index)" />
          <view class="remove-image" @click="removeImage(index)">
            <text class="remove-image-text">x</text>
          </view>
        </view>
        <view v-if="imagePaths.length < 3" class="add-image" @click="chooseImages">
          <text class="add-image-icon">+</text>
          <text class="add-image-label">添加图片</text>
        </view>
      </view>

      <text class="section-title contact-heading">联系方式（选填）</text>
      <input class="contact-input" v-model="contact" placeholder="手机号或邮箱，方便我们联系你" placeholder-class="input-placeholder"
        maxlength="100" />
    </view>

    <view class="notice">
      <text class="notice-text">请勿在反馈中填写密码等敏感信息。</text>
    </view>

    <button :class="isSubmitting ? 'submit-button submit-button-disabled' : 'submit-button'"
      :disabled="isSubmitting" @click="submitFeedback">
      {{ isSubmitting ? '提交中...' : '提交反馈' }}
    </button>
  </view>
</template>

<script setup>
const feedbackTypes = ['功能建议', '问题反馈', '其他']
const selectedType = ref('功能建议')
const content = ref('')
const contact = ref('')
const imagePaths = ref<string[]>([])
const imageFileIDs = ref<string[]>([])
const isSubmitting = ref(false)

function selectType(type: string) {
  selectedType.value = type
}

function chooseImages() {
  if (isSubmitting.value) {
    return
  }

  const remainingCount = 3 - imagePaths.value.length
  uni.chooseImage({
    count: remainingCount,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: (result) => {
      const selectedPaths = result.tempFilePaths.slice(0, remainingCount)
      imagePaths.value = imagePaths.value.concat(selectedPaths).slice(0, 3)
      imageFileIDs.value = imageFileIDs.value.concat(selectedPaths.map(() => ''))
    },
    fail: (error) => {
      console.error('选择反馈图片失败', error)
      uni.showToast({
        title: '选择图片失败',
        icon: 'none'
      })
    }
  })
}

function previewImage(index: number) {
  uni.previewImage({
    current: index,
    urls: imagePaths.value
  })
}

function removeImage(index: number) {
  if (isSubmitting.value) {
    return
  }

  imagePaths.value.splice(index, 1)
  imageFileIDs.value.splice(index, 1)
}

function getImageExtension(path: string): string {
  const queryIndex = path.indexOf('?')
  const cleanPath = queryIndex >= 0 ? path.substring(0, queryIndex) : path
  const dotIndex = cleanPath.lastIndexOf('.')
  if (dotIndex < 0) {
    return 'jpg'
  }

  const extension = cleanPath.substring(dotIndex + 1).toLowerCase()
  if (extension === 'jpg' || extension === 'jpeg' || extension === 'png' || extension === 'webp') {
    return extension
  }
  return 'jpg'
}

async function submitFeedback() {
  if (isSubmitting.value) {
    return
  }

  const normalizedContent = content.value.trim()
  if (normalizedContent.length === 0) {
    uni.showToast({
      title: '请先填写反馈内容',
      icon: 'none'
    })
    return
  }

  isSubmitting.value = true
  try {
    for (let index = 0; index < imagePaths.value.length; index += 1) {
      if (imageFileIDs.value[index].length > 0) {
        continue
      }

      const cloudPath = `feedback/${Date.now()}_${index}_${Math.random().toString(36).slice(2)}.${getImageExtension(imagePaths.value[index])}`
      const uploadResult = await uniCloud.uploadFile({
        filePath: imagePaths.value[index],
        cloudPath
      })
      imageFileIDs.value[index] = uploadResult.fileID
    }

    await uniCloud.callFunction({
      name: 'feedback',
      data: {
        type: selectedType.value,
        content: normalizedContent,
        contact: contact.value.trim(),
        images: imageFileIDs.value
      }
    })

    content.value = ''
    contact.value = ''
    imagePaths.value = []
    imageFileIDs.value = []
    uni.showToast({
      title: '反馈提交成功',
      icon: 'success'
    })
  } catch (error) {
    console.error('提交意见反馈失败', error)
    uni.showToast({
      title: '提交失败，请检查网络后重试',
      icon: 'none'
    })
  } finally {
    isSubmitting.value = false
  }
}
</script>

<style lang="scss">
