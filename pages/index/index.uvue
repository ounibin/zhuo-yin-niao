<template>
  <view class="page">
    <view class="page-heading">
      <text class="page-title">拼音卡片</text>
      <text class="page-subtitle">认识拼音，从这里开始</text>
    </view>

    <view v-for="group in pinyinGroups" :key="group.title" class="pinyin-section">
      <view class="section-heading">
        <text class="section-title">{{ group.title }}</text>
        <text class="section-count">{{ group.items.length }} 个</text>
      </view>
      <view class="pinyin-grid">
        <view
          v-for="item in group.items"
          :key="item"
          class="pinyin-card"
          @click="openPinyin(item)"
        >
          <view class="pinyin-card-content">
            <text class="pinyin-text">{{ item }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup>
  import { playTabBarSound } from '../../utils/tabbar-sound.uts'

  const pinyinGroups = [
    {
      title: '单韵母',
      items: ['a', 'o', 'e', 'i', 'u', 'ü']
    },
    {
      title: '复韵母',
      items: [
        'ai', 'ei', 'ui', 'ao', 'ou', 'iu', 'ie', 'üe', 'er',
        'an', 'en', 'in', 'un', 'ün', 'ang', 'eng', 'ing', 'ong'
      ]
    },
    {
      title: '声母',
      items: [
        'b', 'p', 'm', 'f', 'd', 't', 'n', 'l', 'g', 'k', 'h',
        'j', 'q', 'x', 'zh', 'ch', 'sh', 'r', 'z', 'c', 's', 'y', 'w'
      ]
    },
    {
      title: '整体认读音节',
      items: ['zhi', 'chi', 'shi', 'ri', 'zi', 'ci', 'si', 'yi', 'wu', 'yu', 'ye', 'yue', 'yuan', 'yin', 'yun', 'ying']
    }
  ]

  onTabItemTap(() => {
    playTabBarSound()
  })

  function openPinyin(pinyin) {
    uni.navigateTo({
      url: `/pages/pinyin-detail/pinyin-detail?pinyin=${pinyin}`
    })
  }
</script>

